# Python
.venv/
__pycache__/
*.pyc

# Blender
*.blend1
*.blend2
*.blend[0-9]
*.blend@

# レンダリング出力(連番PNG・動画)
*.mp4
ep1/*.mp40*.png
ep1/Rikenomics_Episode01.mp4*.png
# アニメーションレンダーが静止画ファイル名に連番を付加してしまう事故(ep1/ep2で発生)
*.png[0-9][0-9][0-9][0-9].png

# macOS
.DS_Store

# ep3のPNG連番(mp4の素材)
ep3/frames/

# 背景の全天マップ(約190MB)。再取得元: https://svs.gsfc.nasa.gov/4851 の milkyway_2020_8k_gal.exr と hiptyc_2020_16k_gal.exr
ep3/textures/*.exr

# ep4のPNG連番と交通流の計算のキャッシュ(スクリプトから再生成できる)
ep4/frames/
ep4/preview_frames/
ep4/draft_frames/
ep4/cache/

# 画像・音楽・動画はGitHubに入れない(公開リポジトリのため。素材の出どころやプロンプトは文章で残し、
# ファイルそのものはiCloud等にバックアップする)。2026-10-04から。それ以前のコミットの履歴には残っている
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.exr
*.hdr
*.tif
*.tiff
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.mov
